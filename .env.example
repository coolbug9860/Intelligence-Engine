# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# On Render, set these in the dashboard (Environment) — NOT in the repo.

# ── Core runtime ─────────────────────────────────────────────────────────────
# Gemini API key — get from aistudio.google.com   [Required]
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI key — get from newsapi.org              [Optional]
NEWS_API_KEY=your_newsapi_key_here

# Login credentials — set these in Render env too  [Required]
KAISO_USERNAME=choose_a_username
KAISO_PASSWORD=choose_a_strong_password

# ── Zero-Cost Ingestion Layer — credentials ─────────────────────────────────
# U.S. Federal Register (Module 1) via api.data.gov — also gates the SAM
# watchlist source. Connector skips cleanly if absent.            [Required]
DATA_GOV_API_KEY=your_data_gov_api_key_here

# SAM.gov — surgical by-ID lookups only (no mass discovery). Lookups are
# skipped if absent; protected by a 10/day quota gate.            [Required]
SAM_GOV_API_KEY=your_sam_gov_api_key_here

# EU EPO Open Patent Services (OPS v3.2) — OAuth2 client credentials.
# Connector skips cleanly if either is absent.                    [Required for EPO stream]
EPO_CONSUMER_KEY=your_epo_consumer_key_here
EPO_CONSUMER_SECRET=your_epo_consumer_secret_here

# U.S. BLS API v2 registration key — its OWN key (NOT DATA_GOV_API_KEY).
# Optional: without it, the keyless tier (~25 queries/day) covers the daily
# 2-series reference refresh.                                     [Optional]
BLS_API_KEY=your_bls_api_key_here

# NOTE: EU TED and UK FTS / Contracts Finder use public, key-free APIs — no
# credentials required.

# ── Competitor white-space detection (Tavily SERP) ──────────────────────────
# Powers whiteSpaceStatus / CONFIRMED_GAP scoring. WITHOUT this key the detector
# returns UNKNOWN for every opportunity (degraded coverage — not a failure).
# Free tier: 1,000 searches/month, commercial-use OK, no card. Get one at
# tavily.com → set here and in Render.                            [Recommended]
TAVILY_API_KEY=your_tavily_api_key_here
# Optional SERP run tuning — [System Defaults]; override only if you must.
# SERP_RUN_BUDGET=12        # max billable searches per pipeline run
# SERP_DELAY_MS=1200        # inter-call delay between searches
# SERP_REFRESH_MS=604800000 # 7d cache freshness window
# SERP_CACHE_PATH=/tmp/serp-cache.json

# ── Durable quota state (Upstash Redis REST) ────────────────────────────────
# Optional but RECOMMENDED on Render. Render's disk (/tmp) is wiped on every
# restart/deploy, which resets the SAM.gov daily and EPO weekly quota counters
# (re-opening the budget) and the EPO throttle cooldown. Set both vars to make
# that state durable. If absent, the app silently falls back to /tmp files.
#
# ALSO powers the Google Trends cache: a scheduled GitHub Action
# (.github/workflows/trends-fetch.yml) fetches trends from a non-Render IP and
# writes them here (keys `kaiso:trend:v1:*` + queue `kaiso:trend:requested`);
# the app reads cache-first and enqueues misses. Add these same two values as
# GitHub repo secrets (Settings → Secrets → Actions) for the Action to work.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── System defaults — override only if you must ─────────────────────────────
# Connectors cache to /tmp with a 24h TTL and use a 10s request timeout.
# These [System Defaults] are baked in; set them only to override.
# TED_CACHE_PATH=/tmp/ted-cache.json
# UKFTS_CACHE_PATH=/tmp/ukfts-cache.json
# UKFTS_TIMEOUT_MS=10000
# FR_CACHE_PATH=/tmp/federal-register-cache.json
# EPO_CACHE_PATH=/tmp/epo-cache.json
# BLS_CACHE_PATH=/tmp/bls-reference.json
# SAMGOV_QUOTA_PATH=/tmp/samgov-quota.json
# SAMGOV_DAILY_LIMIT=10
#
# EU EPO free-tier guardrails (Task 5.2) — protect the OPS weekly allowance and
# prevent retry storms. All [System Defaults]; override only if you must.
# EPO_WEEKLY_LIMIT=1000              # hard-stop: max upstream OPS requests per rolling 7 days
# EPO_WEEKLY_QUOTA_PATH=/tmp/epo-weekly-quota.json   # persistent weekly request counter
# EPO_COOLDOWN_PATH=/tmp/epo-cooldown.json           # negative cache written on a 429/403 (honors Retry-After, default 1h)
# EPO_TOKEN_PATH=/tmp/epo-token.json                 # cached OAuth bearer token (reused until ~60s before expiry)
#
# Lookback windows (days) — tuned to each source's publication cadence.
# TED and UK FTS are fixed at 24h (continuous publishers). [System Defaults]
# FR_LOOKBACK_DAYS=4    # Federal Register skips weekends/holidays
# EPO_LOOKBACK_DAYS=7   # EPO publishes weekly (Wednesdays)

# ── Adzuna Jobs API — hiring-momentum signals ───────────────────────────────
# Free registration at developer.adzuna.com/signup → app_id + app_key (no
# identity verification). The connector reads active-vacancy counts for 3 broad
# vertical keyword groups and synthesizes hiring-momentum signals. Skips cleanly
# if either is absent. At most 3 calls per cache-miss run (24h cache).
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# Optional — [System Defaults]; override only if you must.
# ADZUNA_COUNTRY=us              # two-letter Adzuna country code
# ADZUNA_CACHE_PATH=/tmp/adzuna-cache.json
