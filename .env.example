# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Gemini API key — get from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI key (optional) — get from newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Login credentials — set these in Render environment variables too
KAISO_USERNAME=choose_a_username
KAISO_PASSWORD=choose_a_strong_password
